{
  "name": "polybill",
  "version": "0.1.0",
  "description": "Provider-neutral billing SDK for TypeScript and Cloudflare Workers",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "worker": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polybill/adapter-kit": "workspace:^",
    "@polybill/application": "workspace:^",
    "@polybill/core": "workspace:^"
  },
  "devDependencies": {
    "@polybill/store-memory": "workspace:^",
    "@polybill/testing": "workspace:^"
  }
}
