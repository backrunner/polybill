{
  "name": "@polybill/store-d1",
  "version": "0.1.0",
  "description": "Cloudflare D1 control-plane schema and inbox store for Polybill",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "worker": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polybill/application": "workspace:^",
    "@polybill/core": "workspace:^",
    "@polybill/licensing": "workspace:^",
    "@polybill/webhooks": "workspace:^"
  },
  "devDependencies": {
    "@polybill/testing": "workspace:^",
    "miniflare": "3.20250718.3",
    "vitest": "4.1.11"
  }
}
