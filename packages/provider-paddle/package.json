{
  "name": "@polybill/provider-paddle",
  "version": "0.1.0",
  "description": "Cloudflare-safe Paddle Billing adapter for Polybill",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "worker": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polybill/adapter-kit": "workspace:^",
    "@polybill/core": "workspace:^"
  },
  "devDependencies": {
    "@polybill/testing": "workspace:^",
    "vitest": "4.1.11"
  }
}
